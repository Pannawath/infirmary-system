generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Student {
  id           String          @id @default(uuid())
  studentCode  String          @unique
  personType   String          @default("STUDENT")
  department   String?
  position     String?
  fullName     String
  gradeLevel   String
  classroom    String
  allergies    String?
  chronicDiseases String?
  guardianPhone String?
  isActive     Boolean @default(true)
  visits       InfirmaryVisit[]
  enrollments  StudentEnrollment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Medication {
  id           String          @id @default(uuid())
  name         String          @unique
  category     String          @default("ยาทั่วไป")
  unit         String          @default("เม็ด")
  stockQuantity Int            @default(0)
  minThreshold Int             @default(10)
  indications  String?
  dispensedItems DispensedItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model InfirmaryVisit {
  id             String          @id @default(uuid())
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id])
  studentNameSnapshot String?
  gradeSnapshot String?
  classroomSnapshot String?
  academicYearSnapshot Int?
  symptoms       String
  serviceType    String @default("DISPENSE")
  bodyTemperature Float?
  bloodPressure  String?
  pulseRate      Int?
  bedRest        Boolean         @default(false)
  bedRestStart   DateTime?
  bedRestEnd     DateTime?
  treatmentNotes String?
  status         String          @default("COMPLETED")
  dispensedItems DispensedItem[]
  visitedAt      DateTime        @default(now())
  createdAt      DateTime        @default(now())
}

model DispensedItem {
  id           String         @id @default(uuid())
  visitId      String
  visit        InfirmaryVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicationId String
  medication   Medication     @relation(fields: [medicationId], references: [id])
  quantity     Int
  instructions String?
  createdAt    DateTime       @default(now())
}

model AcademicTerm {
  id String @id @default(uuid())
  academicYear Int
  termNumber Int
  startDate DateTime
  endDate DateTime
  @@unique([academicYear, termNumber])
}

model SchoolYear {
  id String @id @default(uuid())
  year Int @unique
  createdAt DateTime @default(now())
  enrollments StudentEnrollment[]
  imports StudentImport[]
}

model StudentEnrollment {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  yearId String
  year SchoolYear @relation(fields: [yearId], references: [id])
  gradeLevel String
  classroom String
  rollNumber String?
  status String @default("ACTIVE")
  updatedAt DateTime @updatedAt
  @@unique([studentId, yearId])
  @@index([yearId, status])
}

model StudentImport {
  id String @id @default(uuid())
  yearId String
  year SchoolYear @relation(fields: [yearId], references: [id])
  filename String
  personType String @default("STUDENT")
  fileHash String
  rowsJson String
  baseVersion String
  status String @default("PREVIEW")
  resultJson String?
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  changes StudentImportChange[]
}

model StudentImportChange {
  id String @id @default(uuid())
  importId String
  batch StudentImport @relation(fields: [importId], references: [id])
  studentCode String
  kind String
  changesJson String
  createdAt DateTime @default(now())
  @@index([studentCode])
}

model AppSetting {
  key String @id
  value String
}
